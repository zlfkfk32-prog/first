# Copy to .env beside run.py. Never upload .env or paste credentials in chat.
# --demo and --check-config never call NAVER or send email.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional Microsoft 365 application credentials. Admin consent to Graph Mail.Send required.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SENDER=
# Multiple addresses: separate with commas. Keep recipient data out of source control.
M365_TO=
